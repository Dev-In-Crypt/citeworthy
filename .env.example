# Скопировать в .env и заполнить. .env в git не попадает.

# --- Database / queue (значения совпадают с docker-compose.yml) ---
DATABASE_URL=postgresql://aisdos:aisdos@localhost:5433/aisdos
REDIS_URL=redis://localhost:6380

# --- Режим адаптеров платформ ---
# mock = fixture-ответы, сеть не используется (по умолчанию для разработки и тестов)
# live = реальные API, требует ключей ниже
ADAPTERS_MODE=mock

# --- LLM-платформы (нужны только при ADAPTERS_MODE=live) ---
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# --- Storage (S3-совместимое; MinIO появится в T06) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- App / auth ---
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# --- Billing / observability (T54, T55) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
